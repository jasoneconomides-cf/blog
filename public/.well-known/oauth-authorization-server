{
  "issuer": "https://blog.ukpetpassport.com",
  "authorization_endpoint": "https://ukpetpassport.com/.well-known/oauth-authorize",
  "token_endpoint": "https://ukpetpassport.com/.well-known/oauth-token",
  "jwks_uri": "https://ukpetpassport.com/.well-known/jwks.json",
  "registration_endpoint": "https://ukpetpassport.com/.well-known/oauth-register",
  "scopes_supported": ["read:content"],
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "client_credentials"],
  "token_endpoint_auth_methods_supported": ["none"],
  "service_documentation": "https://blog.ukpetpassport.com/auth.md",
  "agent_auth": {
    "skill": "https://blog.ukpetpassport.com/auth.md",
    "register_uri": "https://ukpetpassport.com/.well-known/oauth-register",
    "claim_uri": "https://ukpetpassport.com/.well-known/oauth-claim",
    "revocation_uri": "https://ukpetpassport.com/.well-known/oauth-revoke",
    "identity_types_supported": ["anonymous", "identity_assertion"],
    "anonymous": {
      "credential_types_supported": ["api_key"]
    },
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": ["access_token", "api_key"]
    },
    "events_supported": [
      "https://schemas.workos.com/events/agent/auth/identity/assertion/revoked"
    ]
  }
}
