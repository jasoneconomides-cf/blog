---
const {
  title = 'UK Pet Passport Blog',
  description = 'GOV.UK-sourced guidance for UK pet owners travelling abroad after Brexit.',
  pubDate,
  updatedDate,
  author = 'UK Pet Passport',
  image,
  wide = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const publishedTime = pubDate ? new Date(pubDate).toISOString() : null;
const modifiedTime = updatedDate ? new Date(updatedDate).toISOString() : null;
const imageURL = image ? new URL(image, Astro.site) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="UK Pet Passport Blog RSS" href="/rss.xml" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="UK Pet Passport Blog" />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {imageURL && <meta name="twitter:card" content="summary_large_image" />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <style>
      :root {
        color-scheme: light;
        --text: #1d252d;
        --muted: #5c6670;
        --line: #d9e0e7;
        --link: #005ea5;
        --bg: #ffffff;
        --soft: #f4f7fa;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        font-size: 18px;
        line-height: 1.65;
      }

      a {
        color: var(--link);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.15em;
      }

      a:hover {
        text-decoration-thickness: 0.14em;
      }

      header,
      main,
      footer {
        width: min(100% - 32px, 720px);
        margin: 0 auto;
      }

      main.wide,
      header,
      footer {
        width: min(100% - 32px, 1120px);
      }

      header {
        padding: 28px 0 20px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      header a {
        font-weight: 700;
        text-decoration: none;
      }

      header > a:first-child {
        white-space: nowrap;
      }

      header nav {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        color: var(--muted);
        font-size: 0.92rem;
      }

      header nav a {
        color: var(--muted);
        font-weight: 650;
      }

      @media (max-width: 520px) {
        header {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }
      }

      main {
        padding: 34px 0 48px;
      }

      footer {
        padding: 24px 0 40px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.95rem;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        margin: 1.8em 0 0.55em;
      }

      h1 {
        margin-top: 0;
        font-size: clamp(2rem, 6vw, 3rem);
      }

      h2 {
        font-size: 1.55rem;
      }

      h3 {
        font-size: 1.25rem;
      }

      p,
      ul,
      ol {
        margin: 0 0 1.15em;
      }

      li {
        margin: 0.35em 0;
      }

      .description {
        color: var(--muted);
        font-size: 1.12rem;
      }

      .post-list {
        list-style: none;
        padding: 0;
      }

      .post-list li {
        padding: 20px 0;
        border-top: 1px solid var(--line);
      }

      .post-list a {
        display: inline-block;
        font-size: 1.2rem;
        font-weight: 700;
      }

      time {
        display: block;
        margin: 0.35rem 0;
        color: var(--muted);
        font-size: 0.95rem;
      }

      code {
        padding: 0.1em 0.25em;
        background: var(--soft);
        border-radius: 4px;
        font-size: 0.95em;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">UK Pet Passport Blog</a>
      <nav aria-label="Primary navigation">
        <a href="https://ukpetpassport.com">Checklist</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>
    <footer>
      <p>This blog provides general information only. Always check the latest <a href="https://www.gov.uk/taking-your-pet-abroad">GOV.UK pet travel guidance</a> and confirm your plans with an Official Veterinarian before travelling.</p>
      <p>For the free UK to Europe Pet Travel Checklist, visit <a href="https://ukpetpassport.com">ukpetpassport.com</a>.</p>
    </footer>
    <script is:inline>
      (() => {
        const modelContext = navigator.modelContext;
        if (!modelContext?.registerTool) return;

        const articles = [
          {
            title: "How to get an Animal Health Certificate",
            url: "https://blog.ukpetpassport.com/posts/animal-health-certificate-guide/",
            topics: ["animal health certificate", "ahc", "documents"],
          },
          {
            title: "Taking your dog to France",
            url: "https://blog.ukpetpassport.com/posts/uk-to-france-dog-after-brexit/",
            topics: ["france", "dog", "travel"],
          },
          {
            title: "Pet travel after Brexit",
            url: "https://blog.ukpetpassport.com/posts/uk-pet-passport-return-2027/",
            topics: ["brexit", "eu", "travel"],
          },
        ];

        modelContext.registerTool({
          name: "list_pet_travel_articles",
          description: "List UK Pet Passport Blog guidance articles for agents and travellers.",
          inputSchema: {
            type: "object",
            properties: {},
            additionalProperties: false,
          },
          execute: async () => ({
            content: [{ type: "text", text: JSON.stringify(articles) }],
          }),
        });

        modelContext.registerTool({
          name: "find_pet_travel_guidance",
          description: "Find relevant UK pet travel guidance by destination, document, or topic.",
          inputSchema: {
            type: "object",
            properties: {
              topic: {
                type: "string",
                description: "A destination, document, or pet travel topic.",
              },
            },
            required: ["topic"],
            additionalProperties: false,
          },
          execute: async ({ topic }) => {
            const query = String(topic).toLowerCase();
            const matches = articles.filter((article) =>
              [article.title, ...article.topics].some((value) =>
                value.toLowerCase().includes(query),
              ),
            );
            return {
              content: [
                {
                  type: "text",
                  text: JSON.stringify(matches.length ? matches : articles),
                },
              ],
            };
          },
        });
      })();
    </script>
  </body>
</html>
