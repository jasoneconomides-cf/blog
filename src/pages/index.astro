---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await Astro.glob('../content/posts/*.md');

const sortedPosts = posts
  .map((post) => {
    const slug = post.file.split('/').pop().replace(/\.md$/, '');
    return { ...post, slug };
  })
  .sort((a, b) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf());

const featuredPost =
  sortedPosts.find((post) => post.slug === 'animal-health-certificate-guide') ?? sortedPosts[0];
const secondaryPosts = sortedPosts.filter((post) => post.slug !== featuredPost.slug);

const formatDate = (date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'UK Pet Passport Blog',
  url: new URL(Astro.url.pathname, Astro.site).href,
  description: 'GOV.UK-sourced guidance for UK pet owners travelling abroad after Brexit.',
  publisher: {
    '@type': 'Organization',
    name: 'UK Pet Passport',
    url: 'https://ukpetpassport.com'
  },
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.frontmatter.title,
    description: post.frontmatter.description,
    datePublished: post.frontmatter.pubDate,
    dateModified: post.frontmatter.updatedDate ?? post.frontmatter.pubDate,
    image: new URL(post.frontmatter.image, Astro.site).href,
    url: new URL(`/posts/${post.slug}/`, Astro.site).href
  }))
};
---

<BaseLayout
  title="UK Pet Passport Blog | GOV.UK-sourced Pet Travel Guidance"
  description="Read clear, GOV.UK-sourced guides for UK pet owners travelling to Europe with dogs, cats and ferrets after Brexit."
  wide
>
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <section class="blog-hero" aria-labelledby="blog-title">
    <div class="hero-copy">
      <p class="eyebrow">UK pet travel guidance</p>
      <h1 id="blog-title">Clear answers before you cross the border with your pet.</h1>
      <p class="hero-description">
        Practical, GOV.UK-sourced guides for UK owners travelling to Europe with dogs, cats and ferrets after Brexit.
      </p>
      <div class="hero-actions">
        <a class="primary-link" href={featuredPost ? `/posts/${featuredPost.slug}/` : '/rss.xml'}>Start with the AHC guide</a>
        <a class="secondary-link" href="https://ukpetpassport.com">Get the travel checklist</a>
      </div>
    </div>
    {featuredPost && (
      <article class="featured-article">
        <a class="featured-image-link" href={`/posts/${featuredPost.slug}/`} aria-label={featuredPost.frontmatter.title}>
          <img
            src={featuredPost.frontmatter.image}
            alt={featuredPost.frontmatter.imageAlt}
            width="1400"
            height="788"
          />
        </a>
        <div class="featured-content">
          <p class="article-meta">
            <span>{featuredPost.frontmatter.category}</span>
            <time datetime={featuredPost.frontmatter.pubDate}>{formatDate(featuredPost.frontmatter.pubDate)}</time>
          </p>
          <h2><a href={`/posts/${featuredPost.slug}/`}>{featuredPost.frontmatter.title}</a></h2>
          <p>{featuredPost.frontmatter.description}</p>
        </div>
      </article>
    )}
  </section>

  <section class="post-section" aria-labelledby="latest-title">
    <div class="section-heading">
      <p class="eyebrow">Latest articles</p>
      <h2 id="latest-title">Plan the paperwork, route and return journey.</h2>
    </div>

    <div class="post-grid">
      {
        secondaryPosts.map((post) => (
          <article class="post-card">
            <a class="post-image-link" href={`/posts/${post.slug}/`} aria-label={post.frontmatter.title}>
              <img
                src={post.frontmatter.image}
                alt={post.frontmatter.imageAlt}
                width="1400"
                height="788"
                loading="lazy"
              />
            </a>
            <div class="post-card-content">
              <p class="article-meta">
                <span>{post.frontmatter.category}</span>
                <time datetime={post.frontmatter.pubDate}>{formatDate(post.frontmatter.pubDate)}</time>
              </p>
              <h3><a href={`/posts/${post.slug}/`}>{post.frontmatter.title}</a></h3>
              <p>{post.frontmatter.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="source-band" aria-label="Source note">
    <div>
      <p class="eyebrow">Source-led guidance</p>
      <h2>Built to be useful, not dramatic.</h2>
    </div>
    <p>
      We explain pet travel rules in plain English and point back to GOV.UK, so you can double-check the official position before booking vets, ferries or flights.
    </p>
  </section>

  <style>
    .blog-hero {
      display: grid;
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: 34px;
      align-items: center;
      margin: -4px 0 58px;
      padding: 32px 0 58px;
      border-bottom: 1px solid #e4e0f3;
    }

    .hero-copy {
      max-width: 520px;
    }

    .eyebrow {
      margin: 0 0 10px;
      color: #7c3aed;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .blog-hero h1 {
      margin: 0 0 18px;
      color: #1a1a2e;
      font-size: clamp(2.35rem, 5vw, 4.8rem);
      line-height: 0.98;
      max-width: 620px;
    }

    .hero-description {
      color: #4b5563;
      font-size: 1.12rem;
      line-height: 1.72;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .primary-link,
    .secondary-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 18px;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 800;
      line-height: 1.25;
      text-decoration: none;
    }

    .primary-link {
      background: #f59e0b;
      color: #1a1a2e;
      box-shadow: 0 10px 24px rgba(245, 158, 11, 0.22);
    }

    .secondary-link {
      border: 1px solid #d8d2ec;
      color: #2d1b69;
      background: #ffffff;
    }

    .featured-article,
    .post-card {
      overflow: hidden;
      border: 1px solid #e4e0f3;
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 18px 50px rgba(26, 26, 46, 0.08);
    }

    .featured-image-link,
    .post-image-link {
      display: block;
      overflow: hidden;
      aspect-ratio: 16 / 9;
      background: #f5f3ff;
    }

    .featured-image-link img,
    .post-image-link img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.25s ease;
    }

    .featured-image-link:hover img,
    .post-image-link:hover img {
      transform: scale(1.025);
    }

    .featured-content {
      padding: 26px;
    }

    .featured-content h2,
    .post-card-content h3,
    .section-heading h2,
    .source-band h2 {
      margin: 0;
      color: #1a1a2e;
      line-height: 1.15;
    }

    .featured-content h2 {
      font-size: clamp(1.55rem, 3vw, 2.15rem);
    }

    .featured-content h2 a,
    .post-card-content h3 a {
      color: inherit;
      text-decoration: none;
    }

    .featured-content h2 a:hover,
    .post-card-content h3 a:hover {
      color: #7c3aed;
    }

    .featured-content p:last-child,
    .post-card-content p:last-child {
      margin: 12px 0 0;
      color: #55515f;
      line-height: 1.7;
    }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 12px;
      align-items: center;
      margin: 0 0 12px;
      color: #686275;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .article-meta span {
      color: #7c3aed;
    }

    .article-meta time {
      display: inline;
      margin: 0;
      color: #686275;
      font-size: inherit;
    }

    .post-section {
      margin-bottom: 58px;
    }

    .section-heading {
      max-width: 650px;
      margin-bottom: 24px;
    }

    .section-heading h2,
    .source-band h2 {
      font-size: clamp(1.8rem, 3vw, 2.55rem);
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }

    .post-card-content {
      padding: 22px;
    }

    .post-card-content h3 {
      font-size: 1.35rem;
    }

    .source-band {
      display: grid;
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
      gap: 28px;
      align-items: center;
      margin: 10px 0 18px;
      padding: 32px;
      border-radius: 8px;
      background: #1a1a2e;
      color: #ffffff;
    }

    .source-band h2 {
      color: #ffffff;
    }

    .source-band p:last-child {
      margin: 0;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.75;
    }

    @media (max-width: 860px) {
      .blog-hero,
      .source-band {
        grid-template-columns: 1fr;
      }

      .blog-hero {
        padding-top: 18px;
      }
    }

    @media (max-width: 680px) {
      .post-grid {
        grid-template-columns: 1fr;
      }

      .blog-hero h1 {
        font-size: 2.45rem;
      }

      .featured-content,
      .post-card-content,
      .source-band {
        padding: 20px;
      }

      .primary-link,
      .secondary-link {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
