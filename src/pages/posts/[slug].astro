---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/posts/*.md');

  return posts.map((post) => {
    const slug = post.file.split('/').pop().replace(/\.md$/, '');
    return {
      params: { slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
const { title, description, pubDate, updatedDate, image, imageAlt, category } = post.frontmatter;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const headings = await post.getHeadings();
const articleHeadings = headings.filter(
  ({ depth, text }) => depth === 2 && !['Source', 'Sources', 'Official sources'].includes(text)
);
const organizationId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const webpageId = `${canonicalURL}#webpage`;
const articleId = `${canonicalURL}#article`;
const breadcrumbId = `${canonicalURL}#breadcrumb`;
const imageURL = new URL(image, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'UK Pet Passport',
      url: 'https://ukpetpassport.com/'
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', Astro.site).href,
      name: 'UK Pet Passport Blog',
      publisher: { '@id': organizationId },
      inLanguage: 'en-GB'
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalURL,
      name: title,
      description,
      isPartOf: { '@id': websiteId },
      breadcrumb: { '@id': breadcrumbId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: imageURL
      },
      inLanguage: 'en-GB'
    },
    {
      '@type': 'BlogPosting',
      '@id': articleId,
      url: canonicalURL,
      headline: title,
      description,
      datePublished: pubDate,
      dateModified: updatedDate ?? pubDate,
      image: {
        '@type': 'ImageObject',
        url: imageURL
      },
      mainEntityOfPage: { '@id': webpageId },
      isPartOf: { '@id': websiteId },
      author: { '@id': organizationId },
      publisher: { '@id': organizationId },
      articleSection: category,
      inLanguage: 'en-GB',
      hasPart: articleHeadings.map(({ slug, text }) => ({
        '@type': 'WebPageElement',
        '@id': `${canonicalURL}#${slug}`,
        url: `${canonicalURL}#${slug}`,
        name: text
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbId,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'UK Pet Passport Blog',
          item: new URL('/', Astro.site).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: title,
          item: canonicalURL
        }
      ]
    }
  ]
};

const formatDate = (date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
---

<BaseLayout title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article>
    <h1>{title}</h1>
    <p class="article-meta">
      {category && <span>{category}</span>}
      <span>Published <time datetime={pubDate}>{formatDate(pubDate)}</time></span>
      {updatedDate && <span>Updated <time datetime={updatedDate}>{formatDate(updatedDate)}</time></span>}
    </p>
    {image && <img class="article-image" src={image} alt={imageAlt} width="1400" height="788" />}
    <p class="description">{description}</p>
    {articleHeadings.length > 0 && (
      <nav class="article-contents" aria-labelledby="article-contents-title">
        <h2 id="article-contents-title">In this post we cover:</h2>
        <ul>
          {articleHeadings.map(({ slug, text }) => (
            <li><a href={`#${slug}`}>{text}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <Content />

    <aside class="bulletin-cta" aria-labelledby="bulletin-title">
      <p class="bulletin-eyebrow">UK Pet Passport Bulletin</p>
      <h2 id="bulletin-title">Waiting for UK pet passports to return?</h2>
      <p>
        Join the bulletin for clear updates when official UK/EU pet-travel guidance changes.
        While you wait, we’ll send you our free pre-travel checklist.
      </p>
      <a href="https://ukpetpassport.com/?utm_source=blog&utm_medium=article&utm_campaign=pet-passport-bulletin#checklist">
        Join the bulletin and get the checklist
      </a>
      <small>Free checklist. Occasional updates. No spam. Unsubscribe any time.</small>
    </aside>
  </article>

  <style>
    .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 12px;
      align-items: center;
      margin: -0.35rem 0 1.35rem;
      color: #686275;
      font-size: 0.92rem;
      font-weight: 700;
    }

    .article-meta span {
      color: #7c3aed;
    }

    .article-meta time {
      display: inline;
      margin: 0;
      color: #686275;
      font-size: inherit;
    }

    .article-image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      margin: 0 0 1.5rem;
      border-radius: 8px;
    }

    .article-contents {
      margin: 1.75rem 0 2.25rem;
      padding: 22px 24px;
      border: 1px solid #ddd6fe;
      border-left: 5px solid #7c3aed;
      border-radius: 8px;
      background: #faf9ff;
    }

    .article-contents h2 {
      margin: 0 0 12px;
      color: #1a1a2e;
      font-size: 1.15rem;
    }

    .article-contents ul {
      margin: 0;
      padding-left: 1.25rem;
    }

    .article-contents li {
      margin: 0.4rem 0;
    }

    .article-contents a {
      font-weight: 650;
    }

    .bulletin-cta {
      margin: 3rem 0 0;
      padding: 28px;
      border: 1px solid #ddd6fe;
      border-radius: 10px;
      background: linear-gradient(135deg, #f5f3ff 0%, #fff7ed 100%);
      box-shadow: 0 16px 36px rgba(45, 27, 105, 0.08);
    }

    .bulletin-cta .bulletin-eyebrow {
      margin: 0 0 8px;
      color: #7c3aed;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .bulletin-cta h2 {
      margin: 0 0 12px;
      color: #1a1a2e;
    }

    .bulletin-cta p {
      margin-bottom: 18px;
    }

    .bulletin-cta a {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      padding: 12px 18px;
      border-radius: 8px;
      background: #f59e0b;
      color: #1a1a2e;
      font-weight: 800;
      line-height: 1.25;
      text-decoration: none;
    }

    .bulletin-cta a:hover {
      background: #fbbf24;
    }

    .bulletin-cta small {
      display: block;
      margin-top: 12px;
      color: #686275;
      font-size: 0.82rem;
    }
  </style>
</BaseLayout>
