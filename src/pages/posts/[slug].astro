---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/posts/*.md');

  return posts.map((post) => {
    const slug = post.file.split('/').pop().replace(/\.md$/, '');
    return {
      params: { slug },
      props: { post }
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
const { title, description, pubDate, updatedDate, image, imageAlt, category } = post.frontmatter;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate,
  dateModified: updatedDate ?? pubDate,
  image: new URL(image, Astro.site).href,
  mainEntityOfPage: canonicalURL,
  author: {
    '@type': 'Organization',
    name: 'UK Pet Passport',
    url: 'https://ukpetpassport.com'
  },
  publisher: {
    '@type': 'Organization',
    name: 'UK Pet Passport',
    url: 'https://ukpetpassport.com'
  },
  articleSection: category
};

const formatDate = (date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
---

<BaseLayout title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} image={image}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article>
    <h1>{title}</h1>
    <p class="article-meta">
      {category && <span>{category}</span>}
      <span>Published <time datetime={pubDate}>{formatDate(pubDate)}</time></span>
      {updatedDate && <span>Updated <time datetime={updatedDate}>{formatDate(updatedDate)}</time></span>}
    </p>
    {image && <img class="article-image" src={image} alt={imageAlt} width="1400" height="788" />}
    <p class="description">{description}</p>
    <Content />
  </article>

  <style>
    .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 12px;
      align-items: center;
      margin: -0.35rem 0 1.35rem;
      color: #686275;
      font-size: 0.92rem;
      font-weight: 700;
    }

    .article-meta span {
      color: #7c3aed;
    }

    .article-meta time {
      display: inline;
      margin: 0;
      color: #686275;
      font-size: inherit;
    }

    .article-image {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      margin: 0 0 1.5rem;
      border-radius: 8px;
    }
  </style>
</BaseLayout>
